<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>nl.datasteel.crudcraft</groupId>
        <artifactId>crudcraft-parent</artifactId>
        <version>1.0.10</version>
    </parent>
    <artifactId>crudcraft-sample-app</artifactId>
    <packaging>jar</packaging>
    <name>CrudCraft Demo App</name>

    <properties>
        <crudcraft.automatic.module.name>nl.datasteel.crudcraft.sample.app</crudcraft.automatic.module.name>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.tomcat.embed</groupId>
                    <artifactId>tomcat-embed-el</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>nl.datasteel.crudcraft</groupId>
            <artifactId>crudcraft-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>nl.datasteel.crudcraft</groupId>
            <artifactId>crudcraft-codegen</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>nl.datasteel.crudcraft</groupId>
            <artifactId>crudcraft-tools</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-h2console</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.expressly</groupId>
            <artifactId>expressly</artifactId>
            <version>6.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.auth0</groupId>
            <artifactId>java-jwt</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-annotations</artifactId>
        </dependency>
        <!-- OAuth2 Resource Server for JWT bearer token support -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct-processor</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec.maven.plugin.version}</version>
                <executions>
                    <execution>
                        <id>copy-editable-sources</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>nl.datasteel.crudcraft.tools.EditableFileTool</mainClass>
                            <classpathScope>compile</classpathScope>
                            <arguments>
                                <argument>${project.build.directory}/generated-sources/annotations</argument>
                                <argument>${project.basedir}/src/main/java</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>patch-generated-spotbugs</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>nl.datasteel.crudcraft.tools.GeneratedSpotBugsTool</mainClass>
                            <classpathScope>compile</classpathScope>
                            <arguments>
                                <argument>${project.build.directory}/generated-sources/annotations</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>nl.datasteel.crudcraft</groupId>
                        <artifactId>crudcraft-tools</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>nl.datasteel.crudcraft</groupId>
                            <artifactId>crudcraft-codegen</artifactId>
                            <version>${project.version}</version>
                        </path>
                        <path>
                            <groupId>nl.datasteel.crudcraft</groupId>
                            <artifactId>crudcraft-api</artifactId>
                            <version>${project.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- Generated/editable CRUD artifacts are covered by codegen tests. -->
                        <exclude>nl/datasteel/crudcraft/sample/**/controller/**</exclude>
                        <exclude>nl/datasteel/crudcraft/sample/**/dto/**</exclude>
                        <exclude>nl/datasteel/crudcraft/sample/**/mapper/**</exclude>
                        <exclude>nl/datasteel/crudcraft/sample/**/meta/**</exclude>
                        <exclude>nl/datasteel/crudcraft/sample/**/search/**</exclude>
                        <exclude>nl/datasteel/crudcraft/sample/**/service/**</exclude>
                        <exclude>nl/datasteel/crudcraft/sample/projection/**</exclude>
                        <!-- Pure JPA state holders are exercised through integration tests. -->
                        <exclude>nl/datasteel/crudcraft/sample/blog/Author*</exclude>
                        <exclude>nl/datasteel/crudcraft/sample/blog/Category*</exclude>
                        <exclude>nl/datasteel/crudcraft/sample/blog/Comment*</exclude>
                        <exclude>nl/datasteel/crudcraft/sample/blog/Post*</exclude>
                        <exclude>nl/datasteel/crudcraft/sample/blog/Tag*</exclude>
                        <exclude>nl/datasteel/crudcraft/sample/blog/content/Article*</exclude>
                        <exclude>nl/datasteel/crudcraft/sample/blog/content/Content*</exclude>
                        <exclude>nl/datasteel/crudcraft/sample/blog/content/Tutorial*</exclude>
                        <exclude>nl/datasteel/crudcraft/sample/scope/ScopedRecord*</exclude>
                        <exclude>nl/datasteel/crudcraft/sample/security/WritePolicyProbe*</exclude>
                        <exclude>nl/datasteel/crudcraft/sample/user/User*</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.1.4</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <configuration>
                    <threads>2</threads>
                    <timeoutFactor>3.0</timeoutFactor>
                    <timeoutConstant>10000</timeoutConstant>
                    <targetClasses>
                        <param>nl.datasteel.crudcraft.sample.blog.dto.request.TagRequestDto</param>
                        <param>nl.datasteel.crudcraft.sample.blog.dto.request.TagRequestDto$Builder</param>
                        <param>nl.datasteel.crudcraft.sample.blog.dto.response.TagResponseDto</param>
                        <param>nl.datasteel.crudcraft.sample.blog.dto.response.TagResponseDto$Builder</param>
                        <param>nl.datasteel.crudcraft.sample.blog.search.TagSearchRequest</param>
                    </targetClasses>
                    <targetTests>
                        <param>nl.datasteel.crudcraft.sample.blog.GeneratedArtifactMutationTest</param>
                    </targetTests>
                    <excludedMethods>
                        <param>builder</param>
                        <param>fieldSecurityMetadata</param>
                    </excludedMethods>
                    <mutationThreshold>95</mutationThreshold>
                    <coverageThreshold>95</coverageThreshold>
                    <testStrengthThreshold>95</testStrengthThreshold>
                </configuration>
                <executions>
                    <execution>
                        <id>pitest-generated-roundtrip</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>mutationCoverage</goal>
                        </goals>
                        <configuration>
                            <reportsDirectory>${project.build.directory}/pit-reports/generated-roundtrip</reportsDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
